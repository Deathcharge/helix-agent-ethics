{
  "schema_version": 1,
  "id": "restricted-read-candidate-guardrail",
  "version": "1.0.0-candidate",
  "description": "Candidate organization guardrail requiring review for restricted reads.",
  "default_effect": "review",
  "rules": [
    {
      "id": "review-restricted-read",
      "effect": "review",
      "priority": 15,
      "message": "Read access to restricted data requires human review.",
      "conditions": [
        {
          "field": "action.capabilities",
          "operator": "contains",
          "value": "resource:read"
        },
        {
          "field": "context.data_sensitivity",
          "operator": "eq",
          "value": "restricted"
        }
      ]
    }
  ]
}
