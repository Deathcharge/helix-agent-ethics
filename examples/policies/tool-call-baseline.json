{
  "schema_version": 1,
  "id": "tool-call-baseline",
  "version": "1.0.0",
  "description": "Fail-closed baseline for read, destructive, external, and sensitive tool capabilities.",
  "default_effect": "review",
  "rules": [
    {
      "id": "deny-missing-tool-context-version",
      "effect": "deny",
      "priority": 0,
      "message": "The tool-call context version is required.",
      "conditions": [
        {"field": "tool_context_version", "operator": "not_exists"}
      ]
    },
    {
      "id": "deny-unsupported-tool-context-version",
      "effect": "deny",
      "priority": 0,
      "message": "The tool-call context version is unsupported.",
      "conditions": [
        {"field": "tool_context_version", "operator": "neq", "value": 1}
      ]
    },
    {
      "id": "deny-missing-tool-kind",
      "effect": "deny",
      "priority": 0,
      "message": "The tool-call kind is required.",
      "conditions": [
        {"field": "action.kind", "operator": "not_exists"}
      ]
    },
    {
      "id": "deny-unsupported-tool-kind",
      "effect": "deny",
      "priority": 0,
      "message": "Only normalized tool-call actions are supported.",
      "conditions": [
        {"field": "action.kind", "operator": "neq", "value": "tool_call"}
      ]
    },
    {
      "id": "deny-destructive-without-approval",
      "effect": "deny",
      "priority": 10,
      "message": "Destructive tool calls require explicit human approval.",
      "conditions": [
        {"field": "action.capabilities", "operator": "contains", "value": "destructive"},
        {"field": "context.human_approved", "operator": "not_exists"}
      ]
    },
    {
      "id": "deny-destructive-after-rejection",
      "effect": "deny",
      "priority": 10,
      "message": "The destructive tool call was not approved.",
      "conditions": [
        {"field": "action.capabilities", "operator": "contains", "value": "destructive"},
        {"field": "context.human_approved", "operator": "eq", "value": false}
      ]
    },
    {
      "id": "review-external-without-approval",
      "effect": "review",
      "priority": 20,
      "message": "External side effects require human review.",
      "conditions": [
        {"field": "action.capabilities", "operator": "contains", "value": "external:write"},
        {"field": "context.human_approved", "operator": "not_exists"}
      ]
    },
    {
      "id": "deny-external-after-rejection",
      "effect": "deny",
      "priority": 20,
      "message": "The external side effect was rejected.",
      "conditions": [
        {"field": "action.capabilities", "operator": "contains", "value": "external:write"},
        {"field": "context.human_approved", "operator": "eq", "value": false}
      ]
    },
    {
      "id": "allow-approved-destructive",
      "effect": "allow",
      "priority": 100,
      "message": "The destructive tool call has explicit approval.",
      "conditions": [
        {"field": "action.capabilities", "operator": "contains", "value": "destructive"},
        {
          "field": "action.capabilities",
          "operator": "subset_of",
          "value": ["resource:read", "destructive", "external:write", "data:sensitive"]
        },
        {"field": "context.human_approved", "operator": "eq", "value": true}
      ]
    },
    {
      "id": "allow-approved-external",
      "effect": "allow",
      "priority": 100,
      "message": "The external side effect has explicit approval.",
      "conditions": [
        {"field": "action.capabilities", "operator": "contains", "value": "external:write"},
        {
          "field": "action.capabilities",
          "operator": "subset_of",
          "value": ["resource:read", "destructive", "external:write", "data:sensitive"]
        },
        {"field": "context.human_approved", "operator": "eq", "value": true}
      ]
    },
    {
      "id": "allow-read",
      "effect": "allow",
      "priority": 100,
      "message": "Read-only tool calls are allowed.",
      "conditions": [
        {"field": "action.capabilities", "operator": "contains", "value": "resource:read"},
        {
          "field": "action.capabilities",
          "operator": "subset_of",
          "value": ["resource:read", "destructive", "external:write", "data:sensitive"]
        }
      ]
    },
    {
      "id": "warn-sensitive-data",
      "effect": "warn",
      "priority": 200,
      "message": "The tool call may access sensitive data.",
      "conditions": [
        {"field": "action.capabilities", "operator": "contains", "value": "data:sensitive"}
      ]
    }
  ]
}
