{
  "policy_deployment_version": 1,
  "policy": {
    "schema_version": 1,
    "id": "tool-call-baseline",
    "version": "1.0.0",
    "description": "Fail-closed baseline for read, destructive, external, and sensitive tool capabilities.",
    "default_effect": "review",
    "rules": [
      {
        "id": "deny-missing-tool-context-version",
        "effect": "deny",
        "conditions": [
          {
            "field": "tool_context_version",
            "operator": "not_exists"
          }
        ],
        "message": "The tool-call context version is required.",
        "priority": 0
      },
      {
        "id": "deny-unsupported-tool-context-version",
        "effect": "deny",
        "conditions": [
          {
            "field": "tool_context_version",
            "operator": "neq",
            "value": 1
          }
        ],
        "message": "The tool-call context version is unsupported.",
        "priority": 0
      },
      {
        "id": "deny-missing-tool-kind",
        "effect": "deny",
        "conditions": [
          {
            "field": "action.kind",
            "operator": "not_exists"
          }
        ],
        "message": "The tool-call kind is required.",
        "priority": 0
      },
      {
        "id": "deny-unsupported-tool-kind",
        "effect": "deny",
        "conditions": [
          {
            "field": "action.kind",
            "operator": "neq",
            "value": "tool_call"
          }
        ],
        "message": "Only normalized tool-call actions are supported.",
        "priority": 0
      },
      {
        "id": "deny-destructive-without-approval",
        "effect": "deny",
        "conditions": [
          {
            "field": "action.capabilities",
            "operator": "contains",
            "value": "destructive"
          },
          {
            "field": "context.approval.approved",
            "operator": "not_exists"
          }
        ],
        "message": "Destructive tool calls require explicit human approval.",
        "priority": 10
      },
      {
        "id": "deny-destructive-after-rejection",
        "effect": "deny",
        "conditions": [
          {
            "field": "action.capabilities",
            "operator": "contains",
            "value": "destructive"
          },
          {
            "field": "context.approval.approved",
            "operator": "eq",
            "value": false
          }
        ],
        "message": "The destructive tool call was not approved.",
        "priority": 10
      },
      {
        "id": "review-external-without-approval",
        "effect": "review",
        "conditions": [
          {
            "field": "action.capabilities",
            "operator": "contains",
            "value": "external:write"
          },
          {
            "field": "context.approval.approved",
            "operator": "not_exists"
          }
        ],
        "message": "External side effects require human review.",
        "priority": 20
      },
      {
        "id": "deny-external-after-rejection",
        "effect": "deny",
        "conditions": [
          {
            "field": "action.capabilities",
            "operator": "contains",
            "value": "external:write"
          },
          {
            "field": "context.approval.approved",
            "operator": "eq",
            "value": false
          }
        ],
        "message": "The external side effect was rejected.",
        "priority": 20
      },
      {
        "id": "allow-approved-destructive",
        "effect": "allow",
        "conditions": [
          {
            "field": "action.capabilities",
            "operator": "contains",
            "value": "destructive"
          },
          {
            "field": "action.capabilities",
            "operator": "subset_of",
            "value": [
              "resource:read",
              "destructive",
              "external:write",
              "data:sensitive"
            ]
          },
          {
            "field": "context.approval.approved",
            "operator": "eq",
            "value": true
          }
        ],
        "message": "The destructive tool call has explicit approval.",
        "priority": 100
      },
      {
        "id": "allow-approved-external",
        "effect": "allow",
        "conditions": [
          {
            "field": "action.capabilities",
            "operator": "contains",
            "value": "external:write"
          },
          {
            "field": "action.capabilities",
            "operator": "subset_of",
            "value": [
              "resource:read",
              "destructive",
              "external:write",
              "data:sensitive"
            ]
          },
          {
            "field": "context.approval.approved",
            "operator": "eq",
            "value": true
          }
        ],
        "message": "The external side effect has explicit approval.",
        "priority": 100
      },
      {
        "id": "allow-read",
        "effect": "allow",
        "conditions": [
          {
            "field": "action.capabilities",
            "operator": "contains",
            "value": "resource:read"
          },
          {
            "field": "action.capabilities",
            "operator": "subset_of",
            "value": [
              "resource:read",
              "destructive",
              "external:write",
              "data:sensitive"
            ]
          }
        ],
        "message": "Read-only tool calls are allowed.",
        "priority": 100
      },
      {
        "id": "warn-sensitive-data",
        "effect": "warn",
        "conditions": [
          {
            "field": "action.capabilities",
            "operator": "contains",
            "value": "data:sensitive"
          }
        ],
        "message": "The tool call may access sensitive data.",
        "priority": 200
      }
    ]
  },
  "context_contract": {
    "context_contract_version": 1,
    "id": "tool-call-context",
    "version": "1.0.0",
    "description": "Policy-visible facts supplied by the Samsarix tool-call boundary.",
    "fields": {
      "tool_context_version": {
        "type": "integer",
        "required": true
      },
      "actor": {
        "type": "object",
        "required": true
      },
      "action": {
        "type": "object",
        "required": true
      },
      "action.kind": {
        "type": "string",
        "required": true
      },
      "action.capabilities": {
        "type": "array",
        "required": true,
        "items": "string"
      },
      "context": {
        "type": "object",
        "required": true
      },
      "context.approval": {
        "type": "object",
        "required": false
      },
      "context.approval.approved": {
        "type": "boolean",
        "required": false
      }
    }
  },
  "deployment_lock": {
    "deployment_lock_version": 1,
    "policy": {
      "id": "tool-call-baseline",
      "version": "1.0.0",
      "fingerprint": "v1:sha256:20c8e54cce2b07face13cc515e2e69e7ef711adef29a28906670d90cce2fdba2"
    },
    "context_contract": {
      "id": "tool-call-context",
      "version": "1.0.0",
      "fingerprint": "v1:sha256:6fa3da2cba9fde85e844a7fb96c3df3110b36152481af5831815c599388de7fc"
    }
  }
}
