{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.samsarix.com/schemas/agent-ethics/tool-approval/v1.json",
  "title": "Samsarix tool-call approval v1",
  "description": "Caller-owned approval evidence bound to one normalized tool call.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_version",
    "tool_call_id",
    "approved",
    "tool_call_fingerprint"
  ],
  "properties": {
    "approval_version": {"const": 1},
    "tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "approved": {"type": "boolean"},
    "tool_call_fingerprint": {
      "type": "string",
      "pattern": "^v1:sha256:[0-9a-f]{64}$"
    }
  }
}
