{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.samsarix.com/agent-ethics/policy-composition/v1.json",
  "title": "Samsarix Agent Ethics policy composition report v1",
  "description": "Value-minimized provenance for deterministic central policy composition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "composition_version",
    "policy_id",
    "policy_version",
    "policy_fingerprint",
    "default_effect",
    "source_count",
    "total_rules",
    "sources"
  ],
  "properties": {
    "composition_version": {"const": 1},
    "policy_id": {"$ref": "#/$defs/identifier"},
    "policy_version": {"$ref": "#/$defs/identifier"},
    "policy_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "default_effect": {"enum": ["allow", "deny", "review"]},
    "source_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "total_rules": {"type": "integer", "minimum": 0, "maximum": 1000},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^v1:sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_fingerprint", "rule_count"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/identifier"},
        "policy_version": {"$ref": "#/$defs/identifier"},
        "policy_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "rule_count": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    }
  }
}
