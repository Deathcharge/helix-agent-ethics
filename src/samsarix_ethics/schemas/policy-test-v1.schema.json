{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.samsarix.com/agent-ethics/policy-test/v1.json",
  "title": "Samsarix Agent Ethics policy-test suite v1",
  "description": "Regression cases for a Samsarix Agent Ethics policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input", "expected_outcome"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "input": {"type": "object"},
        "expected_outcome": {"enum": ["allow", "deny", "review"]},
        "expected_matched_rules": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "expected_warning_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  }
}
